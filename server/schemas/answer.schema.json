{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Answer object (CONTRACT 5.7)",
  "type": "object",
  "required": ["answer_id", "question", "doc_ids", "answer", "citations", "evidence", "trace", "route", "cost", "latency_ms"],
  "properties": {
    "answer_id": {"type": "string", "minLength": 1},
    "question": {"type": "string"},
    "doc_ids": {"type": "array", "items": {"type": "string"}},
    "answer": {
      "type": "object",
      "required": ["text_md", "value", "unit", "confidence", "abstained"],
      "properties": {
        "text_md": {"type": "string"},
        "value": {"description": "Number, string, boolean, array, null, or for a multi-kind count an object {kind: count}, e.g. {\"window\": 11, \"door\": 11}.", "type": ["number", "string", "boolean", "array", "object", "null"], "additionalProperties": {"type": "number"}},
        "unit": {"type": ["string", "null"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "abstained": {"type": "boolean"}
      }
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["n", "doc_id", "page", "kind", "bbox_px", "item_ids", "quote"],
        "properties": {
          "n": {"type": "integer", "minimum": 1},
          "doc_id": {"type": "string"},
          "page": {"type": "integer", "minimum": 1},
          "kind": {"enum": ["region", "text", "element"]},
          "bbox_px": {"type": ["array", "null"], "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
          "item_ids": {"type": "array", "items": {"type": "string"}},
          "quote": {"type": ["string", "null"]},
          "item_kind": {"type": "string", "description": "Kind of the cited items in a multi-kind count (window, door, ...)."}
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["boxes", "scene"],
      "properties": {
        "boxes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["item_id", "page", "bbox_px", "label"],
            "properties": {
              "item_id": {"type": "string"},
              "page": {"type": "integer", "minimum": 1},
              "bbox_px": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
              "label": {"type": "string"},
              "kind": {"type": "string", "description": "Kind of the boxed item (window, door, ...) so clients can colour by kind."}
            }
          }
        },
        "scene": {
          "type": "object",
          "required": ["doc_id", "highlight_item_ids", "camera_target_item_id"],
          "properties": {
            "doc_id": {"type": "string"},
            "highlight_item_ids": {"type": "array", "items": {"type": "string"}},
            "camera_target_item_id": {"type": ["string", "null"]},
            "item_kinds": {"type": "object", "additionalProperties": {"type": "string"}, "description": "item_id -> kind for the highlighted items of a multi-kind answer."},
            "commands": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["op"],
                "properties": {
                  "op": {"enum": ["highlight", "hide", "restore", "reset", "isolate", "move", "material"]},
                  "item_ids": {"type": "array", "items": {"type": "string"}},
                  "labels": {"type": "object", "additionalProperties": {"type": "string"}},
                  "offset_m": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
                  "material": {"type": ["string", "null"]}
                }
              }
            }
          }
        }
      }
    },
    "trace": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "detail", "ms", "model", "cost_usd"],
        "properties": {
          "step": {"type": "string"},
          "detail": {"type": "string"},
          "ms": {"type": "number"},
          "model": {"type": ["string", "null"]},
          "cost_usd": {"type": "number"}
        }
      }
    },
    "route": {"enum": ["index", "planmap", "vlm", "hybrid"]},
    "cost": {
      "type": "object",
      "required": ["usd_total", "calls"],
      "properties": {"usd_total": {"type": "number"}, "calls": {"type": "array"}}
    },
    "latency_ms": {"type": "number"},
    "advisor_cards": {
      "type": "array", "maxItems": 3,
      "description": "Advisor cards (CONTRACT 5.12) for a hide/remove command: the same checks on the edited model.",
      "items": {
        "type": "object",
        "required": ["card_id", "kind", "title", "body", "item_ids", "source"],
        "properties": {
          "card_id": {"type": "string"},
          "kind": {"enum": ["warning", "option", "info"]},
          "severity": {"enum": ["violation", "suggestion", "info"], "description": "violation = a rule is broken; suggestion = worth checking; info = nothing broken or nothing checkable."},
          "title": {"type": "string", "maxLength": 60},
          "body": {"type": "string", "maxLength": 200},
          "item_ids": {"type": "array", "items": {"type": "string"}},
          "checked": {"type": "array", "items": {"type": "string"}, "description": "Rule ids (engine/rules) checked for this result."},
          "source": {"type": "object", "required": ["type", "ref", "title", "quote"],
                     "properties": {"type": {"type": "string"}, "ref": {"type": "string"}, "title": {"type": "string"}, "quote": {"type": "string"}}}
        }
      }
    }
  }
}
